# ─── Web server ────────────────────────────────────────────────
# Address the Node server listens on. Keep it on loopback: cloudflared
# connects locally, so nothing needs to be exposed on the LAN.
HOST=127.0.0.1
PORT=8022

# Public origin served by the Cloudflare Tunnel (used to validate the
# WebSocket Origin header). Comma-separate multiple origins.
PUBLIC_ORIGIN=https://terminal.example.com

# ─── Login ─────────────────────────────────────────────────────
# Where the password hash, its salt and the session-signing key are kept.
# Set the password with:  scripts/set-password.sh
SECRETS_DIR=~/.config/ssh-web-interfacer

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# ─── SSH target ────────────────────────────────────────────────
# Users supply their own private key in the browser; no key is stored here.
SSH_HOST=127.0.0.1
SSH_PORT=22

# Optional: pre-fills the username field on the connect screen.
SSH_DEFAULT_USERNAME=

# Optional but recommended: pin the server's host key. Get it with:
#   ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub   (use the part after "SHA256:")
SSH_HOST_KEY_SHA256=
