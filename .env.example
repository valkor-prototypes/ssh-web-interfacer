# ─── Web server ────────────────────────────────────────────────
# Address the Node server listens on. Keep it on loopback: cloudflared
# connects locally, so nothing needs to be exposed on the LAN.
HOST=127.0.0.1
PORT=8022

# Public origin served by the Cloudflare Tunnel (used to validate the
# WebSocket Origin header). Comma-separate multiple origins.
PUBLIC_ORIGIN=https://terminal.example.com

# ─── Login ─────────────────────────────────────────────────────
# Generate with:  npm run hash-password
APP_PASSWORD_HASH=

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# ─── SSH target ────────────────────────────────────────────────
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USERNAME=

# Private key: either a path to the key file (preferred) ...
SSH_PRIVATE_KEY_PATH=/home/youruser/.ssh/ssh-web-interfacer
# ... or the key itself, base64-encoded on a single line:
#   base64 -w0 ~/.ssh/ssh-web-interfacer
SSH_PRIVATE_KEY_BASE64=
# Passphrase for the key, if it has one.
SSH_PRIVATE_KEY_PASSPHRASE=
# Optional but recommended: pin the server's host key. Get it with:
#   ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub   (use the part after "SHA256:")
SSH_HOST_KEY_SHA256=
